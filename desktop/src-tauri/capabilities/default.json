{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main Anydrop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:scope-appdata",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/anydrop-coordinator", "sidecar": true }]
    },
    "autostart:default"
  ]
}
