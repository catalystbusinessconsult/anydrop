{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anydrop",
  "version": "0.1.0",
  "identifier": "com.catalystbusinessconsult.anydrop",
  "build": {
    "beforeDevCommand": "npm run dev -w web",
    "beforeBuildCommand": "npm run build -w web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Anydrop",
        "width": 900,
        "height": 700,
        "minWidth": 480,
        "minHeight": 560,
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "tooltip": "Anydrop"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/anydrop-coordinator"],
    "resources": []
  },
  "plugins": {
    "autostart": {
      "macosLauncher": "LaunchAgent"
    }
  }
}
