node_modules/
dist/
build/
*.log
.env
.env.local
.DS_Store

# Electron packaged output
desktop/release/
desktop/electron/main.bundle.cjs
desktop/electron/coordinator.bundle.cjs

# local one-off scratch tooling (mkcert binary, icon-gen script + deps) —
# not part of the shipped repo
.tools/

# certs — except the shared office-LAN cert/key and the root CA that
# signed them, all three committed intentionally: every laptop and the CI
# build need the same identity, and the app verifies coordinators against
# that CA itself rather than each machine's OS trust store (see
# installCertificateVerifier in desktop/electron/main.cjs). The CA file
# being caught by this blanket rule is why CI-built releases shipped
# without it for several versions.
*.pem
*.crt
*.key
!web/certs/cert.pem
!web/certs/key.pem
!web/public/anydrop-root-ca.pem

# test output
coverage/
